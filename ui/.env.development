# Vite auto-loads this file when running `pnpm dev`.
#
# In dev mode, the SPA runs on Vite's dev server (port 5173) and hits the
# Spring Boot API directly at port 8080 - there's no nginx in the path, so
# the /api -> server:8080 proxy from the Docker setup doesn't apply.
#
# For Docker, this file is ignored. The Docker build uses the placeholder
# `__VITE_APP_BASE_URL__` at build time, and docker-entrypoint.sh substitutes
# the runtime value at container startup.
#
# Note: with this URL, the browser will fire a CORS preflight against the
# API. CorsConfig.java already allows http://localhost:5173 as an origin.

VITE_APP_BASE_URL=http://localhost:8080
