# .env.example - reference for env vars consumed by docker-compose.yml.
#
# Copy to `.env` (auto-loaded by Compose) only if you want to override one of
# the defaults. The stack works with all defaults; nothing here is required.

# ---- Server (Spring Boot API) ---------------------------------------------
# Mongo connection string. Inside the compose network, "mongo" is the service
# hostname. Change this if you point at an external Mongo (e.g. Atlas).
# SPRING_MONGODB_URI=mongodb://mongo:27017/dreamVote

# ---- UI (React SPA) -------------------------------------------------------
# Base URL the SPA prepends to API calls. Defaults to "/api" (proxied by the
# nginx in the UI container to the server service). Override only if you're
# routing API calls outside the standard same-origin proxy pattern.
# VITE_APP_BASE_URL=/api
